<?xml version="1.0" encoding="utf-8" ?>
<!-- Page de dev uniquement (route #if DEBUG dans AppShell.xaml.cs). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProxiBetApp.Pages.Dev.ComponentGalleryPage"
             xmlns:fonts="clr-namespace:Fonts"
             Shell.NavBarIsVisible="False"
             Title="Component Gallery">

    <AuthenticatedPageLayout>

        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource size320}">

            <!-- Typography -->
            <Label Style="{StaticResource Title1}" Text="Title1" />
            <Label Style="{StaticResource Title2}" Text="Title2" />
            <Label Style="{StaticResource LargeTitle}" Text="LargeTitle" />
            <Label Style="{StaticResource Body1}" Text="Body1" />
            <Label Style="{StaticResource Caption1}" Text="Caption1" />

            <Label Style="{StaticResource Title2}" Text="Buttons — texte simple" />
            <ProxiButton Text="ProxiButton Primary/Full" Variant="Primary" Radius="Full" />
            <ProxiButton Text="ProxiButton Primary/Medium" Variant="Primary" Radius="Medium" />
            <ProxiButton Text="ProxiButton Primary/Small" Variant="Primary" Radius="Small" />
            <ProxiButton Text="ProxiButton Secondary/Full" Variant="Secondary" Radius="Full" />
            <ProxiButton Text="ProxiButton Secondary/Medium" Variant="Secondary" Radius="Medium" />
            <ProxiButton Text="ProxiButton Secondary/Small" Variant="Secondary" Radius="Small" />
            <ProxiButton Text="ProxiButton désactivé" Variant="Primary" Radius="Full" IsEnabled="False" />

            <Label Style="{StaticResource Title2}" Text="Buttons — icône seule (Variant=Icon)" />
            <ProxiButton Variant="Icon"
                         Text="{x:Static fonts:FluentUI.person_circle_24_regular}"
                         FontFamily="FluentUI"
                         FontSize="{StaticResource IconSize}" />

            <Label Style="{StaticResource Title2}" Text="Buttons — icône + texte (Variant=Icon)" />
            <ProxiButton Variant="Icon"
                         Text="Accueil"
                         ContentLayout="Top,4"
                         FontFamily="OpenSansRegular">
                <ProxiButton.ImageSource>
                    <FontImageSource FontFamily="FluentUI"
                                     Glyph="{x:Static fonts:FluentUI.home_24_regular}"
                                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </ProxiButton.ImageSource>
            </ProxiButton>

            <Label Style="{StaticResource Title2}" Text="ValidationMessage" />
            <ValidationMessage Text="Ce champ est requis" />
            <Label Style="{StaticResource Caption1}" Text="(instance avec Text vide ci-dessous : ne prend pas de place)" />
            <ValidationMessage Text="" />

            <Label Style="{StaticResource Title2}" Text="FormField" />
            <Label Style="{StaticResource Caption1}" Text="État repos (tap dans le champ ci-dessous pour voir l'état focus)" />
            <FormField FieldLabel="Email" Placeholder="vous@exemple.com" Keyboard="Email" />
            <Label Style="{StaticResource Caption1}" Text="État erreur" />
            <FormField FieldLabel="Mot de passe" Placeholder="Mot de passe" IsPassword="True" ErrorMessage="Mot de passe trop court" />

            <!-- RadioButton : contrôle natif stylé dans Controls.xaml, non encapsulé dans un composant custom. -->
            <Label Style="{StaticResource Title2}" Text="RadioButton" />
            <RadioButton Content="Option 1" GroupName="GalleryRadioDemo" IsChecked="True" />
            <RadioButton Content="Option 2" GroupName="GalleryRadioDemo" />
            <RadioButton Content="Option 3 (désactivée)" GroupName="GalleryRadioDemo" IsEnabled="False" />

            <!-- CheckBox : contrôle natif stylé dans Controls.xaml. -->
            <Label Style="{StaticResource Title2}" Text="CheckBox" />
            <CheckBox IsChecked="True" />
            <Label Style="{StaticResource Caption1}" Text="Désactivée" />
            <CheckBox IsChecked="True" IsEnabled="False" />

            <!-- Switch : contrôle natif stylé dans Controls.xaml. -->
            <Label Style="{StaticResource Title2}" Text="Switch" />
            <Switch IsToggled="True" />

            <Label Style="{StaticResource Title2}" Text="Card" />
            <ProxiCard>
                <VerticalStackLayout Spacing="{StaticResource size80}">
                    <Label Text="Titre de carte" Style="{StaticResource Caption1}" />
                    <Label Text="Contenu de carte" Style="{StaticResource Body1Strong}" />
                </VerticalStackLayout>
            </ProxiCard>

            <Label Style="{StaticResource Caption1}" Text="Color=&quot;Primary&quot; (fond teinté marque)" />
            <ProxiCard Color="Primary">
                <VerticalStackLayout Spacing="{StaticResource size80}">
                    <Label Text="Titre de carte" Style="{StaticResource Caption1}" />
                    <Label Text="Contenu de carte" Style="{StaticResource Body1Strong}" />
                </VerticalStackLayout>
            </ProxiCard>

            <Label Style="{StaticResource Caption1}" Text="HasShadow=&quot;False&quot; (surface plate, sans élévation)" />
            <ProxiCard HasShadow="False">
                <VerticalStackLayout Spacing="{StaticResource size80}">
                    <Label Text="Titre de carte" Style="{StaticResource Caption1}" />
                    <Label Text="Contenu de carte" Style="{StaticResource Body1Strong}" />
                </VerticalStackLayout>
            </ProxiCard>

            <!-- ActivityIndicator/ProgressBar/IndicatorView : contrôles natifs stylés dans Controls.xaml. -->
            <Label Style="{StaticResource Title2}" Text="ActivityIndicator" />
            <ActivityIndicator IsRunning="True" />

            <Label Style="{StaticResource Title2}" Text="ProgressBar" />
            <ProgressBar Progress="0.6" />

            <Label Style="{StaticResource Title2}" Text="IndicatorView" />
            <IndicatorView Count="4" Position="1" />

            <Label Style="{StaticResource Title2}" Text="CenteredFormLayout" />
            <ProxiCard>
                <CenteredFormLayout>
                    <Label Style="{StaticResource Title1}" Text="Exemple de formulaire" HorizontalOptions="Center" />
                    <FormField FieldLabel="Email" Placeholder="vous@exemple.com" Keyboard="Email" />
                    <ProxiButton Text="Valider" />
                </CenteredFormLayout>
            </ProxiCard>

        </VerticalStackLayout>

    </AuthenticatedPageLayout>
</ContentPage>
