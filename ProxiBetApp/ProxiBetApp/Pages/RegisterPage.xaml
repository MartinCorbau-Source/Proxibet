<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ProxiBetApp.PageModels"
             xmlns:components="clr-namespace:ProxiBetApp.Components"
             x:Class="ProxiBetApp.Pages.RegisterPage"
             x:DataType="pageModels:RegisterPageModel"
             Title="Créer un compte">

    <components:CenteredFormLayout>

        <Label Style="{StaticResource Title1}" Text="Créer un compte" HorizontalOptions="Center" />

        <components:FormField FieldLabel="Nom d'affichage" Text="{Binding DisplayName}" Placeholder="Votre nom" />

        <components:FormField FieldLabel="Email" Text="{Binding Email}" Keyboard="Email" Placeholder="vous@exemple.com" />

        <components:FormField FieldLabel="Mot de passe" Text="{Binding Password}" IsPassword="True" Placeholder="Mot de passe" />

        <components:ValidationMessage Text="{Binding ErrorMessage}" />

        <Button Text="Créer mon compte" Command="{Binding RegisterCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Button Text="J'ai déjà un compte" Command="{Binding GoToLoginCommand}" Style="{StaticResource SecondaryButtonStyle}" />

    </components:CenteredFormLayout>
</ContentPage>
