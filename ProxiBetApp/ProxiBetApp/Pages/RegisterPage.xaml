<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProxiBetApp.Pages.RegisterPage"
             x:DataType="RegisterPageModel"
             Title="Créer un compte">

    <CenteredFormLayout>

        <Label Style="{StaticResource Title1}" Text="Créer un compte" HorizontalOptions="Center" />

        <FormField FieldLabel="Nom d'affichage" Text="{Binding DisplayName}" Placeholder="Votre nom" ErrorMessage="{Binding DisplayNameError}" />

        <FormField FieldLabel="Email" Text="{Binding Email}" Keyboard="Email" Placeholder="vous@exemple.com" ErrorMessage="{Binding EmailError}" />

        <FormField FieldLabel="Mot de passe" Text="{Binding Password}" IsPassword="True" Placeholder="Mot de passe" ErrorMessage="{Binding PasswordError}" />

        <ValidationMessage Text="{Binding ErrorMessage}" />

        <ProxiButton Text="Créer mon compte" Command="{Binding RegisterCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <ProxiButton Text="J'ai déjà un compte" Command="{Binding GoToLoginCommand}" Variant="Secondary" />

    </CenteredFormLayout>
</ContentPage>
