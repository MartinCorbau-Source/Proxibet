<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ProxiBetApp.Pages.HomePage"
             x:Name="HomeRoot"
             x:DataType="HomePageModel"
             Shell.NavBarIsVisible="False"
             Title="Accueil">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference HomeRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <AuthenticatedPageLayout>

        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource FormSpacing}">

            <Label Style="{StaticResource Title1}"
                   Text="{Binding User.DisplayName, StringFormat='Bienvenue, {0} !'}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <ValidationMessage Text="{Binding ErrorMessage}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource size160}">
                <ProxiCard Grid.Column="0" Color="Primary">
                    <VerticalStackLayout Spacing="{StaticResource size80}">
                        <Label Text="Paris actifs" Style="{StaticResource Caption1}" />
                        <Label Text="3" Style="{StaticResource Title1}" />
                    </VerticalStackLayout>
                </ProxiCard>
                <ProxiCard Grid.Column="1" Color="Secondary">
                    <VerticalStackLayout Spacing="{StaticResource size80}">
                        <Label Text="Streak" Style="{StaticResource Caption1}" />
                        <Label Text="🔥 x4" Style="{StaticResource Title1}" />
                    </VerticalStackLayout>
                </ProxiCard>
            </Grid>

        </VerticalStackLayout>

    </AuthenticatedPageLayout>
</ContentPage>
