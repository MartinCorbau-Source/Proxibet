<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ProxiBetApp.Pages.MePage"
             x:Name="MeRoot"
             x:DataType="MePageModel"
             Title="Mon profil">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference MeRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource FormSpacing}" MaximumWidthRequest="{StaticResource FormMaxWidth}" HorizontalOptions="Center" VerticalOptions="Center">

        <Label Style="{StaticResource Title1}" Text="Mon profil" HorizontalOptions="Center" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <ValidationMessage Text="{Binding ErrorMessage}" />

        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="8">
                <Label Text="Nom d'affichage" Style="{StaticResource Caption1}" />
                <Label Text="{Binding User.DisplayName}" Style="{StaticResource Body1Strong}" />

                <Label Text="Email" Style="{StaticResource Caption1}" />
                <Label Text="{Binding User.Email}" Style="{StaticResource Body1Strong}" />
            </VerticalStackLayout>
        </Border>

        <Button Text="Se déconnecter" Command="{Binding LogoutCommand}" />

    </VerticalStackLayout>
</ContentPage>
