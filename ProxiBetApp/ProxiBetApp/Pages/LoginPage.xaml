<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProxiBetApp.Pages.LoginPage"
             x:DataType="LoginPageModel"
             Title="Connexion">

    <CenteredFormLayout>

        <Label Style="{StaticResource Title1}" Text="Connexion" HorizontalOptions="Center" />

        <FormField FieldLabel="Email" Text="{Binding Email}" Keyboard="Email" Placeholder="vous@exemple.com" ErrorMessage="{Binding EmailError}" />

        <FormField FieldLabel="Mot de passe" Text="{Binding Password}" IsPassword="True" Placeholder="Mot de passe" ErrorMessage="{Binding PasswordError}" />

        <ValidationMessage Text="{Binding ErrorMessage}" />

        <Button Text="Se connecter" Command="{Binding LoginCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Button Text="Créer un compte" Command="{Binding GoToRegisterCommand}" Style="{StaticResource SecondaryButtonStyle}" />

        <Button Text="[Debug] Component Gallery" Command="{Binding GoToDevGalleryCommand}" Style="{StaticResource SecondaryButtonStyle}" IsVisible="{Binding IsDevGalleryButtonVisible}" />

    </CenteredFormLayout>
</ContentPage>
