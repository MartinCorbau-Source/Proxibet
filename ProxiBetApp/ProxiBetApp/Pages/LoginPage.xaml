<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ProxiBetApp.PageModels"
             xmlns:components="clr-namespace:ProxiBetApp.Components"
             x:Class="ProxiBetApp.Pages.LoginPage"
             x:DataType="pageModels:LoginPageModel"
             Title="Connexion">

    <components:CenteredFormLayout>

        <Label Style="{StaticResource Title1}" Text="Connexion" HorizontalOptions="Center" />

        <components:FormField FieldLabel="Email" Text="{Binding Email}" Keyboard="Email" Placeholder="vous@exemple.com" />

        <components:FormField FieldLabel="Mot de passe" Text="{Binding Password}" IsPassword="True" Placeholder="Mot de passe" />

        <components:ValidationMessage Text="{Binding ErrorMessage}" />

        <Button Text="Se connecter" Command="{Binding LoginCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Button Text="Créer un compte" Command="{Binding GoToRegisterCommand}" Style="{StaticResource SecondaryButtonStyle}" />

    </components:CenteredFormLayout>
</ContentPage>
