<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ProxiBetApp.PageModels"
             x:Class="ProxiBetApp.Pages.LoginPage"
             x:DataType="pageModels:LoginPageModel"
             Title="Connexion">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="15" MaximumWidthRequest="480" HorizontalOptions="Center" VerticalOptions="Center">

            <Label Style="{StaticResource Title1}" Text="Connexion" HorizontalOptions="Center" />

            <Label Text="Email" />
            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="vous@exemple.com" />

            <Label Text="Mot de passe" />
            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Mot de passe" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="Se connecter" Command="{Binding LoginCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Créer un compte" Command="{Binding GoToRegisterCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
