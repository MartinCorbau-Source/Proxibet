<?xml version="1.0" encoding="utf-8" ?>
<!--
Shell des pages authentifiées (Grid Auto,*,Auto : AppHeader + contenu scrollable + BottomNavBar),
dupliqué à l'identique dans HomePage/MePage (et manquant sur ComponentGalleryPage, à l'origine
de ce composant). Même mécanisme de projection que CenteredFormLayout (ContentProperty +
ObservableCollection<View>, voir le .xaml.cs) pour le contenu de la ligne 1.

GoToHome est fixé en dur (Shell.Current.GoToAsync("//home")) dans le code-behind plutôt qu'exposé
en BindableProperty : contrairement à ProfileCommand/ToggleThemeCommand (qui varient réellement),
cette navigation est strictement identique sur tous les call sites existants (HomePageModel et
MePageModel l'exposaient toutes deux via une méthode static, sans état d'instance). Exception
documentée à la convention "composants dumb, commands via BindableProperty".

IsDarkMode/ToggleThemeCommand restent des BindableProperty passthrough : seule leur VALEUR varie
par PageModel, la PLOMBERIE (IsDarkMode bool + ToggleThemeAsync appelant IThemeService) est
dupliquée à l'identique entre PageModels — souci distinct, volontairement hors périmètre ici.

Shell.NavBarIsVisible="False" reste à déclarer sur la ContentPage hôte : propriété attachée Shell
qui s'applique à la page dans l'arborescence Shell, pas positionnable par un ContentView enfant.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProxiBetApp.Components.AuthenticatedPageLayout"
             x:Name="Root">

    <ContentView.Content>
        <Grid RowDefinitions="Auto,*,Auto">

            <AppHeader Grid.Row="0"
                       HeaderTitle="{Binding HeaderTitle, Source={x:Reference Root}}"
                       ProfileCommand="{Binding ProfileCommand, Source={x:Reference Root}}"
                       ShowProfileIcon="{Binding ShowProfileIcon, Source={x:Reference Root}}"
                       IsDarkMode="{Binding IsDarkMode, Source={x:Reference Root}}"
                       ToggleThemeCommand="{Binding ToggleThemeCommand, Source={x:Reference Root}}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout x:Name="InnerLayout" />
            </ScrollView>

            <BottomNavBar Grid.Row="2" x:Name="BottomNav" />

        </Grid>
    </ContentView.Content>

</ContentView>
