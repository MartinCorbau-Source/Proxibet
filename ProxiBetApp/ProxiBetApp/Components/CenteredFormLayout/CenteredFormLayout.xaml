<?xml version="1.0" encoding="utf-8" ?>
<!--
ContentPresenter n'existe qu'en ControlTemplate en MAUI : la projection du contenu de la page
hôte se fait via le code-behind, qui reparente les enfants dans InnerLayout.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProxiBetApp.Components.CenteredFormLayout">

    <ContentView.Content>
        <ScrollView>
            <VerticalStackLayout x:Name="InnerLayout"
                                  Padding="{StaticResource LayoutPadding}"
                                  Spacing="{StaticResource FormSpacing}"
                                  MaximumWidthRequest="{StaticResource FormMaxWidth}"
                                  HorizontalOptions="Center" />
        </ScrollView>
    </ContentView.Content>

</ContentView>
