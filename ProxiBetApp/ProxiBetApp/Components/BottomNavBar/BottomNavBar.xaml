<?xml version="1.0" encoding="utf-8" ?>
<!--
Remplace le TabBar Shell natif : sur Windows, le renderer WinUI n'affiche pas de tab bar tant
qu'il n'y a qu'un seul ShellContent. ProxiButton (pas un TapGestureRecognizer custom) : ce
dernier ne reçoit pas les taps sur Windows, bug WinUI non résolu (dotnet/maui#32279).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="ProxiBetApp.Components.BottomNavBar"
             x:Name="Root">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
          Padding="{StaticResource size20}">

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="{StaticResource size80}"
              HorizontalOptions="Center">

            <ProxiButton Grid.Column="0"
                         Variant="Icon"
                         VerticalOptions="Fill"
                         Command="{Binding GoToHomeCommand, Source={x:Reference Root}}"
                         Text="Accueil"
                         ContentLayout="Top,4"
                         FontFamily="OpenSansRegular">
                <ProxiButton.ImageSource>
                    <FontImageSource FontFamily="FluentUI"
                                     Glyph="{x:Static fonts:FluentUI.home_24_regular}"
                                     Size="{StaticResource NavBarIconSize}"
                                     Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                </ProxiButton.ImageSource>
            </ProxiButton>

            <ProxiButton Grid.Column="1"
                         Variant="Icon"
                         VerticalOptions="Fill"
                         Command="{Binding GoToHomeCommand, Source={x:Reference Root}}"
                         Text="Test"
                         ContentLayout="Top,4"
                         FontFamily="OpenSansRegular">
                <ProxiButton.ImageSource>
                    <FontImageSource FontFamily="FluentUI"
                                     Glyph="{x:Static fonts:FluentUI.apps_shield_20_regular}"
                                     Size="{StaticResource NavBarIconSize}"
                                     Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                </ProxiButton.ImageSource>
            </ProxiButton>

            <ProxiButton Grid.Column="2"
                         Variant="Icon"
                         VerticalOptions="Fill"
                         Command="{Binding GoToGalleryCommand, Source={x:Reference Root}}"
                         IsVisible="{Binding IsGalleryButtonVisible, Source={x:Reference Root}}"
                         Text="Gallery"
                         ContentLayout="Top,4"
                         FontFamily="OpenSansRegular">
                <ProxiButton.ImageSource>
                    <FontImageSource FontFamily="FluentUI"
                                     Glyph="{x:Static fonts:FluentUI.beaker_24_regular}"
                                     Size="{StaticResource NavBarIconSize}"
                                     Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                </ProxiButton.ImageSource>
            </ProxiButton>

        </Grid>

    </Grid>

</ContentView>
