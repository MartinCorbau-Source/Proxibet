<?xml version="1.0" encoding="utf-8" ?>
<!--
Shell de page formulaire (ScrollView + VerticalStackLayout centré, largeur max) dupliqué à
l'identique dans Login/Register/Me. ContentPresenter n'existe qu'en ControlTemplate en MAUI ;
la projection du contenu de la page hôte se fait donc via le code-behind (voir .xaml.cs),
qui reparente les enfants déclarés par la page dans InnerLayout.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProxiBetApp.Components.CenteredFormLayout">

    <ScrollView>
        <VerticalStackLayout x:Name="InnerLayout"
                              Padding="{StaticResource LayoutPadding}"
                              Spacing="{StaticResource FormSpacing}"
                              MaximumWidthRequest="{StaticResource FormMaxWidth}"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
    </ScrollView>

</ContentView>
