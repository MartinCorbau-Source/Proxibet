<?xml version="1.0" encoding="utf-8" ?>
<!--
En-tête partagé des pages authentifiées : titre + bascule thème clair/sombre + icône profil.
Shell.TitleView est par-page/par-ShellContent (pas de partage automatique entre tabs en MAUI
Shell) ; ce composant est donc embarqué en premier enfant du layout de chaque page plutôt
que déclaré via Shell.TitleView, pour éviter de dupliquer ce XAML par ShellContent.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utilities="clr-namespace:ProxiBetApp.Utilities"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="ProxiBetApp.Components.AppHeader"
             x:Name="Root">

    <ContentView.Resources>
        <utilities:ThemeIconConverter x:Key="ThemeIconConverter" />
    </ContentView.Resources>

    <Grid ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="{StaticResource size120}"
          Padding="{StaticResource LayoutPadding}">

        <Label Grid.Column="0"
               Text="{Binding HeaderTitle, Source={x:Reference Root}}"
               Style="{StaticResource Title2}"
               VerticalOptions="Center" />

        <ProxiButton Grid.Column="1"
                     Variant="Icon"
                     Command="{Binding ToggleThemeCommand, Source={x:Reference Root}}"
                     Text="{Binding IsDarkMode, Source={x:Reference Root}, Converter={StaticResource ThemeIconConverter}}"
                     FontFamily="FluentUI"
                     FontSize="{StaticResource IconSize}" />

        <ProxiButton Grid.Column="2"
                     Variant="Icon"
                     Command="{Binding ProfileCommand, Source={x:Reference Root}}"
                     IsVisible="{Binding ShowProfileIcon, Source={x:Reference Root}}"
                     Text="{x:Static fonts:FluentUI.person_circle_24_regular}"
                     FontFamily="FluentUI"
                     FontSize="{StaticResource IconSize}" />

    </Grid>

</ContentView>
