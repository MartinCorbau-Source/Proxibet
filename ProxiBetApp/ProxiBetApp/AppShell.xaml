<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProxiBetApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:ProxiBetApp.Pages"
    xmlns:fonts="clr-namespace:Fonts"
    Shell.FlyoutBehavior="Disabled"
    Title="ProxiBetApp">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

    <TabBar x:Name="MainTabBar" Route="app">
        <Tab Title="Accueil" Route="home">
            <Tab.Icon>
                <FontImageSource FontFamily="FluentUI" Glyph="{x:Static fonts:FluentUI.home_24_regular}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:HomePage}" Route="home" />
        </Tab>

        <Tab Title="Profil" Route="me">
            <Tab.Icon>
                <FontImageSource FontFamily="FluentUI" Glyph="{x:Static fonts:FluentUI.person_circle_24_regular}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:MePage}" Route="me" />
        </Tab>
    </TabBar>

</Shell>
