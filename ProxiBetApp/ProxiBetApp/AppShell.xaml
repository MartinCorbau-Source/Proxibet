<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProxiBetApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:ProxiBetApp.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="ProxiBetApp">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

    <!-- Pas de TabBar Shell natif (invisible sur Windows avec un seul ShellContent) : navigation via BottomNavBar. -->
    <ShellContent
        Title="Accueil"
        ContentTemplate="{DataTemplate pages:HomePage}"
        Route="home" />

</Shell>
