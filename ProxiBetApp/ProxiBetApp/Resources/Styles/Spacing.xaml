<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="sizeNone">0</x:Double>
    <x:Double x:Key="size20">2</x:Double>
    <x:Double x:Key="size40">4</x:Double>
    <x:Double x:Key="size60">6</x:Double>
    <x:Double x:Key="size80">8</x:Double>
    <x:Double x:Key="size100">10</x:Double>
    <x:Double x:Key="size120">12</x:Double>
    <x:Double x:Key="size160">16</x:Double>
    <x:Double x:Key="size200">20</x:Double>
    <x:Double x:Key="size240">24</x:Double>
    <x:Double x:Key="size280">28</x:Double>
    <x:Double x:Key="size320">32</x:Double>
    <x:Double x:Key="size360">36</x:Double>
    <x:Double x:Key="size400">40</x:Double>
    <x:Double x:Key="size480">48</x:Double>
    <x:Double x:Key="size520">52</x:Double>
    <x:Double x:Key="size560">56</x:Double>
    <x:Double x:Key="size640">64</x:Double>

    <!-- https://fluent2.microsoft.design/typography/ -->
    <OnIdiom x:Key="IconSize"
             x:TypeArguments="x:Double"
             Default="20">
        <OnIdiom.Desktop>32</OnIdiom.Desktop>
    </OnIdiom>

    <OnIdiom x:Key="IconSizeSmall"
             x:TypeArguments="x:Double"
             Default="12">
        <OnIdiom.Desktop>18</OnIdiom.Desktop>
    </OnIdiom>

    <OnIdiom x:Key="LayoutPadding"
             x:TypeArguments="Thickness"
             Default="5">
        <OnIdiom.Desktop>5</OnIdiom.Desktop>
    </OnIdiom>

    <OnIdiom x:Key="LayoutSpacing"
             x:TypeArguments="x:Double"
             Default="5">
        <OnIdiom.Desktop>15</OnIdiom.Desktop>
    </OnIdiom>

    <OnIdiom x:Key="InputFontSize"
             x:TypeArguments="x:Double"
             Default="15">
        <OnIdiom.Desktop>16</OnIdiom.Desktop>
    </OnIdiom>

    <x:Double x:Key="FormMaxWidth">480</x:Double>
    <x:Double x:Key="FormSpacing">15</x:Double>

    <x:Double x:Key="IconButtonMinSize">36</x:Double>

    <x:Double x:Key="MinTapTarget">44</x:Double>

    <!-- Vertical réduit vs LayoutPadding : un vertical calqué sur LayoutPadding rendait le bandeau overlay trop haut. -->
    <OnIdiom x:Key="HeaderPadding"
             x:TypeArguments="Thickness"
             Default="15,8">
        <OnIdiom.Desktop>30,12</OnIdiom.Desktop>
    </OnIdiom>

    <!-- Compense la hauteur réelle du header flottant, à ajuster si AppHeader change de hauteur. -->
    <OnIdiom x:Key="HeaderOverlayContentPadding"
             x:TypeArguments="Thickness"
             Default="0,0,0,0">
        <OnIdiom.Desktop>0,0,0,0</OnIdiom.Desktop>
    </OnIdiom>

</ResourceDictionary>
