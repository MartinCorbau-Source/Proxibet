<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!--
    Échelle Primary/Secondary générée par script HSL maison (seed #512BD4, violet MAUI
    d'origine conservé comme ancrage de marque) — pas de Material Design, pas de dépendance
    externe. Contraste WCAG vérifié : Primary400 vs blanc = 6.19:1, Primary300 vs fond sombre
    #17171a = 5.05:1. Voir le plan design system pour la méthode complète.
    -->
    <Color x:Key="Primary50">#F1EEFC</Color>
    <Color x:Key="Primary100">#E0D9F7</Color>
    <Color x:Key="Primary200">#B9AAEE</Color>
    <Color x:Key="Primary300">#9077E3</Color>
    <Color x:Key="Primary400">#6644D9</Color>
    <Color x:Key="Primary500">#4726BB</Color>
    <Color x:Key="Primary600">#3A1F99</Color>
    <Color x:Key="Primary700">#2F197B</Color>
    <Color x:Key="Primary800">#24135D</Color>
    <Color x:Key="Primary900">#180D40</Color>

    <Color x:Key="Secondary50">#F6F2F8</Color>
    <Color x:Key="Secondary100">#EBE1EF</Color>
    <Color x:Key="Secondary200">#D3BCDC</Color>
    <Color x:Key="Secondary300">#B994C7</Color>
    <Color x:Key="Secondary400">#9F6CB2</Color>
    <Color x:Key="Secondary500">#804D93</Color>
    <Color x:Key="Secondary600">#693F79</Color>
    <Color x:Key="Secondary700">#543361</Color>
    <Color x:Key="Secondary800">#40274A</Color>
    <Color x:Key="Secondary900">#2C1A32</Color>

    <!--
    Alias sémantiques utilisés par les styles existants (Buttons, Shell, Switch, ...).
    Valeurs dupliquées depuis l'échelle ci-dessus (Color ne supporte pas {StaticResource}
    en contenu d'élément) : Primary=Primary400, PrimaryDark=Primary300, Secondary=Secondary100,
    SecondaryDarkText=Secondary300, Tertiary=Primary800.
    -->
    <Color x:Key="Primary">#6644D9</Color>
    <Color x:Key="PrimaryDark">#9077E3</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#EBE1EF</Color>
    <Color x:Key="SecondaryDarkText">#B994C7</Color>
    <Color x:Key="Tertiary">#24135D</Color>

    <Color x:Key="Error">#B3261E</Color>
    <Color x:Key="ErrorDark">#F2B8B5</Color>

    <Color x:Key="DarkBackground">#17171a</Color>
    <Color x:Key="LightOnDarkBackground">#C3C3C3</Color>
    <Color x:Key="LightBackground">#F2F2F2</Color>
    <Color x:Key="DarkOnLightBackground">#0D0D0D</Color>

    <Color x:Key="LightSecondaryBackground">#E0E0E0</Color>
    <Color x:Key="DarkSecondaryBackground">#222228</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource ErrorDark}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>