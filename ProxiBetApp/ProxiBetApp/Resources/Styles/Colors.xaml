<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Échelle générée depuis seed #7B27F1 (violet) / #24BD7D (vert menthe). Contraste WCAG vérifié (Primary400/blanc = 5.56:1). -->
    <Color x:Key="Primary50">#F4EEFC</Color>
    <Color x:Key="Primary100">#E6D9F7</Color>
    <Color x:Key="Primary200">#C6AAEE</Color>
    <Color x:Key="Primary300">#A477E3</Color>
    <Color x:Key="Primary400">#8244D9</Color>
    <Color x:Key="Primary500">#6426BB</Color>
    <Color x:Key="Primary600">#521F99</Color>
    <Color x:Key="Primary700">#42197B</Color>
    <Color x:Key="Primary800">#32135D</Color>
    <Color x:Key="Primary900">#220D40</Color>

    <Color x:Key="Secondary50">#F0FBF6</Color>
    <Color x:Key="Secondary100">#DBF5EA</Color>
    <Color x:Key="Secondary200">#AEEAD1</Color>
    <Color x:Key="Secondary300">#7AE0B5</Color>
    <Color x:Key="Secondary400">#42DB9B</Color>
    <Color x:Key="Secondary500">#24BD7D</Color>
    <Color x:Key="Secondary600">#1F9966</Color>
    <Color x:Key="Secondary700">#1B7952</Color>
    <Color x:Key="Secondary800">#155B3E</Color>
    <Color x:Key="Secondary900">#0F3E2A</Color>

    <!-- Alias sémantiques, valeurs dupliquées depuis l'échelle (Color ne supporte pas {StaticResource}). -->
    <Color x:Key="Primary">#8244D9</Color>
    <Color x:Key="PrimaryDark">#A477E3</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DBF5EA</Color>
    <Color x:Key="SecondaryDarkText">#7AE0B5</Color>
    <Color x:Key="Tertiary">#32135D</Color>

    <!-- Dégradé de marque violet→vert menthe, même pattern que HeaderBackgroundGradientLight/Dark (AppHeader.xaml). -->
    <LinearGradientBrush x:Key="GradientHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary400}" Offset="0.0" />
        <GradientStop Color="{StaticResource Secondary500}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary200}" Offset="0.0" />
        <GradientStop Color="{StaticResource Secondary300}" Offset="1.0" />
    </LinearGradientBrush>

    <Color x:Key="Error">#B3261E</Color>
    <Color x:Key="ErrorDark">#F2B8B5</Color>

    <Color x:Key="DarkBackground">#17171a</Color>
    <Color x:Key="LightOnDarkBackground">#C3C3C3</Color>
    <Color x:Key="LightBackground">#F2F2F2</Color>
    <Color x:Key="DarkOnLightBackground">#0D0D0D</Color>

    <Color x:Key="LightSecondaryBackground">#E0E0E0</Color>
    <Color x:Key="DarkSecondaryBackground">#222228</Color>

    <!-- Fond du header overlay (AppHeader) : alpha CC en haut, dégradé vers alpha 00 en bas. -->
    <Color x:Key="HeaderOverlayBackground">#CCF2F2F2</Color>
    <Color x:Key="HeaderOverlayBackgroundDark">#CC17171A</Color>
    <Color x:Key="HeaderOverlayBackgroundTransparent">#00F2F2F2</Color>
    <Color x:Key="HeaderOverlayBackgroundDarkTransparent">#0017171A</Color>

    <!-- Contour des champs de formulaire (FormField), dérivé du grayscale existant. -->
    <Color x:Key="Outline">#919191</Color>
    <Color x:Key="OutlineVariant">#C8C8C8</Color>
    <Color x:Key="OutlineDark">#6E6E6E</Color>
    <Color x:Key="OutlineVariantDark">#404040</Color>

    <!-- Couleur d'ombre pour les tokens d'élévation (Shapes.xaml) — noir en light, -->
    <!-- plus clair en dark pour rester visible sur fond sombre. -->
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="ShadowColorDark">#000000</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource ErrorDark}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>