<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
    Shape system façon Material 3 : une échelle de rayons unique consommée par
    Buttons/Cards/Inputs au lieu de valeurs (8, 20...) dupliquées en dur par fichier.
    "Full" sert aux formes pilule (boutons, chips futurs).
    -->
    <x:Double x:Key="CornerRadiusSmall">8</x:Double>
    <x:Double x:Key="CornerRadiusMedium">12</x:Double>
    <x:Double x:Key="CornerRadiusLarge">16</x:Double>
    <x:Double x:Key="CornerRadiusFull">999</x:Double>

    <!--
    Tokens d'élévation : Radius/Opacity/Offset par niveau, PAS de Shadow instancié ici.
    En MAUI, Shadow hérite de Element (un seul Parent possible) : une seule instance en
    StaticResource plantera dès qu'un 2e Border la consomme ("already has a Parent"). Chaque
    style doit donc créer son propre <Shadow> inline en réutilisant ces valeurs numériques.
    Échelle inspirée de la shadow ramp Fluent 2/Material (blur croissant par niveau).
    -->
    <x:Double x:Key="Elevation1Radius">4</x:Double>
    <x:Double x:Key="Elevation1Opacity">0.12</x:Double>
    <x:Double x:Key="Elevation2Radius">8</x:Double>
    <x:Double x:Key="Elevation2Opacity">0.16</x:Double>
    <x:Double x:Key="Elevation3Radius">16</x:Double>
    <x:Double x:Key="Elevation3Opacity">0.20</x:Double>

</ResourceDictionary>
